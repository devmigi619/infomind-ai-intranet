# AI (FastAPI) 로컬 환경변수 예시 — 이 파일을 ai/.env.local로 복사 후 사용
# .env.local은 .gitignore되어 있어 커밋되지 않음

# JWT 서명 키 — Spring Boot(backend/.env.local)와 동일한 값이어야 함
JWT_SECRET=

# 모델 공급자 선택 — "prod"=사내 GPU(Ollama), "dev"=OpenAI
MODEL_DEFINE=prod

# Ollama — 사내 GPU 서버를 기본으로 사용. 로컬 Ollama 쓰려면 http://localhost:11434
OLLAMA_URL=http://192.168.0.248:11434

# Qdrant (Phase 3 RAG 작업 시 필요. 로컬은 보류)
QDRANT_URL=http://localhost:6333

# 모델 — 사내 GPU 서버 표준 태그.
# 본인 로컬에 다른 태그가 깔려 있으면 `ollama list`로 확인 후 변경.
SLM_MODEL=qwen3:14b
LLM_MODEL=gemma4:31b
TTS_MODEL=deepseek-coder-v2:16b
EMBEDDING_MODEL=bona/bge-m3-korean:latest
EMBEDDING_DIMENSIONS=1024

# CORS — 프론트엔드 주소
ALLOWED_ORIGINS=["*"]

DATABASE_URL=postgresql://intranet_user:Intranet7124787%40%40@192.168.0.248:5434/intranet

# 자비스패널(ai_context) — false면 채팅창 interrupt 중심으로 동작
AI_CONTEXT_ENABLED=true

# OpenAI — MODEL_DEFINE=dev 일 때 사용
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_SLM_MODEL=gpt-4o-mini

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
