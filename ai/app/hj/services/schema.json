            "rules": [
              "aprv_req_desc: JSONB 캐스트 필수 — '{\"aprv_ref_cd\": \"입력값\", ...}'::jsonb",
              "aprv_rslt_se: 신규 신청은 '1'(신청)",
              "req_sum: 결재신청 내용을 한 줄 요약 — 양식명 + 핵심 항목값 조합 (예: '품의서 - OO 사유 신청', '출장신청서 - 2025-06-10 서울 출장')",
              "req_ymd: 오늘 날짜 YYYYMMDD"
            ]
          }
        ],
        "shared": ["aprv_req_sn: 컨텍스트의 [요청 시퀀스] 값을 직접 사용(서브쿼리 금지)"]
      }
    },

