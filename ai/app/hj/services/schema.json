{
  "_meta": {
    "desc": "intent별 테이블 구조·관계·규칙 정의 (JSON). 개발자가 테이블 확정 후 여기에만 추가한다.",
    "column_fields": "name(컬럼명), type(타입), desc(설명), code_group(f_cm_cd 코드그룹), values(코드값=설명 매핑), note(주의사항)",
    "omit": "DEFAULT, NOT NULL, 인덱스, 트리거는 생략",
    "lookup_mode": "ReAct 조회 루프용 경량 스키마. insert_rules·examples·lookup_exclude=true 테이블 제거"
  },

  "functions": {
    "f_cm_cd": {
      "signature": "f_cm_cd(p_up_cd VARCHAR, p_cd VARCHAR) -> VARCHAR",
      "desc": "USE_YN='Y' AND UP_CD=p_up_cd AND CD=p_cd 인 CD_NM 반환. 매칭 없으면 NULL.",
      "args": 2,
      "rules": [
        "인자 반드시 2개 (3개 금지)",
        "따옴표는 단일 따옴표만 사용 ('' 금지)"
      ]
    }
  },

  "global_rules": {
    "se_columns": {
      "rule": "모든 _SE 접미사 컬럼은 f_cm_cd('컬럼명대문자', 값) AS 컬럼명_nm 로 조회",
      "examples": [
        "t.user_se -> f_cm_cd('USER_SE', t.user_se) AS user_se_nm",
        "t.gndr_se -> f_cm_cd('GNDR_SE', t.gndr_se) AS gndr_se_nm"
      ],
      "note": "각 컬럼의 up_cd는 해당 컬럼의 code_group 값을 참고"
    }
  },

  "common_tables": [
    {
      "table": "int_user",
      "desc": "사용자 — 전체 컬럼 (부서·직급 FK 포함)",
      "pk": ["user_id"],
      "fk": [
        {"col": "jbgd_cd", "ref": "int_jbgd.jbgd_cd"},
        {"col": "dept_cd", "ref": "int_dept.dept_cd"}
      ],
      "columns": [
        {"name": "user_id", "type": "VARCHAR", "desc": "사용자 아이디"},
        {"name": "user_nm", "type": "VARCHAR", "desc": "사용자 이름"},
        {"name": "jbgd_cd", "type": "VARCHAR", "desc": "직급코드"},
        {"name": "dept_cd", "type": "VARCHAR", "desc": "부서코드"},
        {"name": "hire_ymd", "type": "VARCHAR(8)", "desc": "입사일 YYYYMMDD"},
        {"name": "resg_ymd", "type": "VARCHAR(8)", "desc": "퇴사일 YYYYMMDD, NULL=재직중"},
        {"name": "user_se", "type": "VARCHAR", "desc": "사용자 구분 코드", "code_group": "USER_SE"}
      ]
    },
    {
      "table": "int_dept",
      "desc": "부서 마스터 — 부서명 조회, 조직도 계층 JOIN 시 필수",
      "pk": ["dept_cd"],
      "fk": [
        {"col": "up_dept_cd", "ref": "int_dept.dept_cd", "note": "자기참조 계층"}
      ],
      "columns": [
        {"name": "dept_cd", "type": "VARCHAR", "desc": "부서코드"},
        {"name": "dept_nm", "type": "VARCHAR", "desc": "부서명"},
        {"name": "up_dept_cd", "type": "VARCHAR", "desc": "상위부서코드"},
        {"name": "dept_lvl", "type": "INT", "desc": "레벨 최상위=1"},
        {"name": "use_yn", "type": "VARCHAR", "values": {"Y": "", "N": ""}}
      ],
      "examples": ["JOIN int_dept d ON u.dept_cd = d.dept_cd"]
    },
    {
      "table": "int_jbgd",
      "desc": "직급 마스터 — 직급명 조회 시 필수",
      "pk": ["jbgd_cd"],
      "columns": [
        {"name": "jbgd_cd", "type": "VARCHAR", "desc": "직급코드"},
        {"name": "jbgd_nm", "type": "VARCHAR", "desc": "직급명"},
        {"name": "jbgd_sn", "type": "INT", "desc": "정렬순서 낮을수록 상위"},
        {"name": "use_yn", "type": "VARCHAR", "values": {"Y": "", "N": ""}}
      ],
      "examples": ["JOIN int_jbgd j ON u.jbgd_cd = j.jbgd_cd"]
    },
    {
      "table": "int_com_code",
      "desc": "공통코드 마스터",
      "pk": ["up_cd", "cd"],
      "columns": [
        {"name": "up_cd", "type": "VARCHAR", "desc": "코드그룹명=컬럼명과 동일"},
        {"name": "cd", "type": "VARCHAR", "desc": "코드값"},
        {"name": "cd_nm", "type": "VARCHAR", "desc": "코드명"},
        {"name": "use_yn", "type": "VARCHAR", "values": {"Y": "", "N": ""}},
        {"name": "cd_ord", "type": "INT", "desc": "정렬순서"}
      ],
      "uses_function": "f_cm_cd"
    }
  ],

  "intents": {
    "leave": {
      "tables": [
        {
          "table": "int_leave_req_mst",
          "desc": "휴가신청 마스터",
          "pk": ["req_user_id", "req_sn"],
          "fk": [
            {"cols": ["leave_cd", "leave_dtl_cd"], "ref": "int_leave_dtl(leave_cd, leave_dtl_cd)", "kind": "physical", "note": "복합 FK — 두 값이 한 쌍으로 존재해야 함"}
          ],
          "join_hints": ["req_user_id ↔ int_user.user_id", "leave_cd ↔ int_leave_mst.leave_cd"],
          "columns": [
            {"name": "req_user_id", "type": "VARCHAR", "desc": "신청자ID"},
            {"name": "req_sn", "type": "BIGINT", "desc": "자동증가"},
            {"name": "leave_rsn", "type": "VARCHAR", "desc": "사유"},
            {"name": "aprv_rslt_se", "type": "VARCHAR", "code_group": "APRV_RSLT_SE"},
            {"name": "leave_cd", "type": "VARCHAR", "desc": "휴가코드"},
            {"name": "leave_dtl_cd", "type": "VARCHAR", "desc": "휴가 상세 코드"},
            {"name": "leave_use_dcnt", "type": "NUMERIC", "desc": "사용일수"},
            {"name": "afile_id", "type": "VARCHAR", "desc": "첨부파일그룹ID NULL 허용"},
            {"name": "dept_ref_yn", "type": "VARCHAR", "values": {"Y": "", "N": ""}}
          ],
          "notes": ["[INSERT 주의] leave_cd·leave_dtl_cd는 int_leave_dtl에 함께 존재하는 쌍만 허용 (참조코드의 leave_cd= 표기 참고)"]
        },
        {
          "table": "int_leave_req_dtl",
          "desc": "휴가신청 일별 상세",
          "pk": ["req_user_id", "req_sn", "leave_use_ymd"],
          "fk": [
            {"cols": ["req_user_id", "req_sn"], "ref": "int_leave_req_mst"}
          ],
          "columns": [
            {"name": "leave_use_ymd", "type": "VARCHAR(8)", "desc": "사용날짜 YYYYMMDD"},
            {"name": "leave_st_hhmm", "type": "VARCHAR(4)", "desc": "시작시간 HHMM"},
            {"name": "leave_end_hhmm", "type": "VARCHAR(4)", "desc": "종료시간 HHMM"}
          ],
          "notes": [
            "위 3개(+감사컬럼)가 전부 — leave_use_dcnt·leave_cd 등은 이 테이블에 없음(마스터 소속)",
            "날짜 비교: TO_DATE(leave_use_ymd, 'YYYYMMDD')"
          ]
        },
        {
          "table": "int_leave_req_aprv",
          "desc": "휴가결재라인",
          "pk": ["req_user_id", "req_sn", "aprv_user_id"],
          "fk": [
            {"cols": ["req_user_id", "req_sn"], "ref": "int_leave_req_mst"}
          ],
          "columns": [
            {"name": "aprv_user_id", "type": "VARCHAR", "desc": "결재자ID"},
            {"name": "aprv_se", "type": "VARCHAR", "code_group": "APRV_SE"},
            {"name": "aprv_ymd", "type": "VARCHAR(8)", "desc": "결재일 YYYYMMDD"},
            {"name": "aprv_ord", "type": "BIGINT", "desc": "결재순서"},
            {"name": "rmk", "type": "TEXT", "desc": "의견 또는 반려사유"}
          ]
        },
        {
          "table": "int_leave_mst",
          "desc": "휴가유형 마스터",
          "pk": ["leave_cd"],
          "columns": [
            {"name": "leave_cd", "type": "VARCHAR", "desc": "휴가코드"},
            {"name": "leave_nm", "type": "VARCHAR", "desc": "휴가이름"},
            {"name": "ded_yn", "type": "VARCHAR", "values": {"Y": "연차차감", "N": "미차감"}},
            {"name": "paid_yn", "type": "VARCHAR", "values": {"Y": "유급", "N": "무급"}}
          ]
        },
        {
          "table": "int_leave_dtl",
          "desc": "휴가유형 상세",
          "pk": ["leave_cd", "leave_dtl_cd"],
          "fk": [
            {"col": "leave_cd", "ref": "int_leave_mst.leave_cd"}
          ],
          "columns": [
            {"name": "leave_dtl_cd", "type": "VARCHAR", "desc": "휴가 상세 코드"},
            {"name": "leave_dtl_nm", "type": "VARCHAR", "desc": "휴가 상세명"},
            {"name": "leave_se", "type": "VARCHAR", "code_group": "LEAVE_SE", "values": {"F": "종일", "H": "부분"}},
            {"name": "use_avl_dcnt", "type": "NUMERIC", "desc": "사용가능일수 NULL이면 무제한"},
            {"name": "use_yn", "type": "VARCHAR", "values": {"Y": "", "N": ""}}
          ]
        },
        {
          "table": "int_leave_pol",
          "desc": "연차정책",
          "pk": ["leave_pol_cd"],
          "columns": [
            {"name": "pol_st_mon", "type": "INT", "desc": "적용시작근속월"},
            {"name": "pol_end_mon", "type": "INT", "desc": "적용종료근속월"},
            {"name": "leave_dcnt", "type": "NUMERIC", "desc": "기본연차일수"},
            {"name": "add_dcnt", "type": "NUMERIC", "desc": "추가일수"},
            {"name": "add_cyc_mon", "type": "INT", "desc": "추가주기월"},
            {"name": "max_dcnt", "type": "NUMERIC", "desc": "최대일수"}
          ],
          "functions": [
            {"signature": "f_leave_calc(p_user_id VARCHAR) -> NUMERIC", "desc": "입사일 기반 부여 연차일수 반환"}
          ],
          "examples": [
            "-- 잔여연차 계산\nSELECT f_leave_calc('user01')\n       - COALESCE((SELECT SUM(leave_use_dcnt) FROM int_leave_req_mst\n                   WHERE req_user_id='user01' AND leave_cd='LEAVE_00001'\n                     AND aprv_rslt_se IN ('1','2','3')), 0) AS remain_dcnt"
          ]
        },
        {
          "table": "int_leave_req_ref",
          "desc": "휴가신청 참조자",
          "pk": ["req_user_id", "req_sn", "ref_user_id"],
          "fk": [
            {"cols": ["req_user_id", "req_sn"], "ref": "int_leave_req_mst"}
          ],
          "columns": [
            {"name": "ref_user_id", "type": "VARCHAR", "desc": "참조자ID"},
            {"name": "qry_yn", "type": "VARCHAR", "values": {"Y": "조회함", "N": "미조회"}}
          ]
        }
      ],
      "insert_rules": {
        "target_tables": ["int_leave_req_mst", "int_leave_req_dtl"],
        "summary": "휴가신청 SQL은 마스터(int_leave_req_mst) + 일별상세(int_leave_req_dtl) 2개 테이블만 생성. 컬럼을 테이블 간 섞지 말 것",
        "forbidden": "int_leave_req_aprv(결재라인)·int_leave_req_ref(참조자) INSERT는 절대 생성하지 말 것 — 사용자 결재선 확정 후 시스템이 자동 삽입함",
        "rows": [
          {
            "table": "int_leave_req_mst",
            "count": "1행",
            "columns": "req_user_id, req_sn, leave_cd, leave_dtl_cd, leave_rsn, aprv_rslt_se, leave_use_dcnt (+감사컬럼)",
            "rules": [
              "leave_cd·leave_dtl_cd: [참조 코드]에서 같은 쌍 선택 (예: 연차 종일 → LEAVE_00001 + LEAVE_00011 / 연차 반차 → LEAVE_00001 + LEAVE_00021)",
              "leave_rsn: 미입력 시 '개인 사정으로 휴가 신청합니다'",
              "aprv_rslt_se: 신규 신청은 '1'(신청)",
              "leave_use_dcnt(※마스터 전용 컬럼): 종일=1.0, 반차=0.5, 시간단위=(종료-시작)시간/8"
            ]
          },
          {
            "table": "int_leave_req_dtl",
            "count": "신청일 수만큼 N행",
            "columns": "leave_use_ymd, leave_st_hhmm, leave_end_hhmm 이 전부 (+감사컬럼)",
            "rules": [
              "leave_use_dcnt·leave_cd 등 다른 컬럼은 이 테이블에 존재하지 않으니 절대 넣지 말 것",
              "신청 기간의 날짜별로 1행씩, 단일 날짜면 1행. 시간은 반차 등 시간단위에만 입력하고 종일이면 NULL"
            ]
          }
        ],
        "shared": ["req_sn: 컨텍스트의 [요청 시퀀스] 값을 마스터·상세에 동일하게 사용(서브쿼리 금지)"]
      }
    },

